{
  "name": "brief",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*"
  ],
  "type": "module",
  "scripts": {
    "build": "vp run -r build",
    "check": "sst install && vp check",
    "dev": "concurrently --kill-others --names api,web,admin,docs --prefix-colors blue,green,magenta,cyan \"vp run @brief/api#dev\" \"vp run @brief/web#dev\" \"vp run @brief/admin#dev\" \"vp run @brief/docs#dev\"",
    "deploy": "vp run -r build && sst deploy",
    "lint": "vp lint",
    "ready": "bun run check && vp test && vp run -r build",
    "scriptc": "vp run @brief/inspect#build",
    "test": "vp test"
  },
  "devDependencies": {
    "@types/bun": "^1.3.5",
    "@types/node": "^26.0.0",
    "concurrently": "^9.2.1",
    "scriptc": "^0.0.21",
    "sst": "^4.17.1",
    "typescript": "^6.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "overrides": {
    "vite": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "bun@1.3.14",
  "catalog": {
    "@tailwindcss/vite": "^4.1.18",
    "@vitejs/plugin-react": "^5.0.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.18",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.7",
    "vite-plus": "0.2.7"
  }
}
